# ─── Área de parceiros (auth + propostas) ─────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha os valores reais.
# `.env.local` é ignorado pelo git — NUNCA commite segredos.

# Banco de dados (Postgres). Localmente aponta para o container do docker-compose.
# Em produção use a connection string POOLED do Neon (host com "-pooler").
DATABASE_URL="postgres://prontta:prontta@localhost:5432/prontta"

# Conexão DIRETA/UNPOOLED — usada apenas pelas migrations (drizzle-kit).
# Localmente é igual à DATABASE_URL. Em produção use o host do Neon SEM "-pooler".
DATABASE_URL_UNPOOLED="postgres://prontta:prontta@localhost:5432/prontta"

# Segredo para assinar a sessão (JWT httpOnly). Gere com:
#   openssl rand -base64 48
# Precisa ter no mínimo 32 caracteres.
SESSION_SECRET="troque-por-uma-string-aleatoria-de-no-minimo-32-caracteres"

# Admin inicial criado pelo `npm run db:seed` (idempotente).
SEED_ADMIN_EMAIL="admin@pronttasaude.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha-forte"
SEED_ADMIN_NAME="Administrador Prontta"
